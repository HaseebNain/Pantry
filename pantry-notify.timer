[Unit]
Description=Check hourly whether it's time to run the Pantry -> Homey notifier

[Timer]
# Runs every hour, on the hour. notify_homey.py itself decides whether *this*
# hour matches your configured weekday/weekend notify time (see
# WEEKDAY_HOUR / WEEKEND_HOUR in pantry-notify.service) and only actually
# contacts Homey once, the first matching hour of the day. This is what makes
# the weekday/weekend times editable without ever touching this timer file.
# (No Persistent=true here — if the Pi is off across several missed hours,
# we don't want it firing a burst of catch-up runs; it'll just check again
# at the next real hour, and the once-per-day mark still applies.)
OnCalendar=*-*-* *:00:00

[Install]
WantedBy=timers.target
